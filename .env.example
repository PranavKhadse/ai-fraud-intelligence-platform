# ==============================================================================
# AI-Powered Fraud Detection & Risk Intelligence Platform
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the placeholder values with your local/environment settings.
# 3. DO NOT commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=fraud_intelligence_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/fraud_intelligence_db

# Machine Learning & Artifact Paths
MODEL_ARTIFACTS_DIR=ml/models/artifacts
ACTIVE_MODEL_VERSION=v1.0.0
DEFAULT_DECISION_THRESHOLD_REVIEW=35.0
DEFAULT_DECISION_THRESHOLD_BLOCK=75.0

# CORS Configuration (Frontend Origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=600
API_V1_PREFIX=/api/v1
